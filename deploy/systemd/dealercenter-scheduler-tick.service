[Unit]
Description=DealerCenter Agent - scheduler tick (polls every 60s for due schedulers)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=dealercenter
Group=dealercenter
WorkingDirectory=/opt/dealercenter-agent/current/backend
# See dealercenter-ingestion-worker.service's comment — same reason.
Environment=PYTHONPATH=/opt/dealercenter-agent/current/backend
ExecStart=/opt/dealercenter-agent/current/backend/venv/bin/python scripts/run_scheduler_tick.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
