# Copy this to .env (repo root — NOT backend/.env) and fill in real
# values. .env is gitignored; never commit it.
#
# Every setting below is read relative to the REPO ROOT regardless of
# which directory a process is started from or what a systemd unit's
# WorkingDirectory is set to (see backend/dealercenter_agent/config.py).

# --- DealerCenter credentials (required) ---
# Read directly via os.environ — no default, the app raises KeyError
# without these. Used by LoginTool whenever a fresh login/MFA is needed.
DEALER_CENTER_USERNAME=
DEALER_CENTER_PASSWORD=

# --- Database (required) ---
# Any SQLAlchemy-compatible URL. A bare postgresql:// or mysql://
# scheme is auto-rewritten to postgresql+psycopg:// / mysql+pymysql://
# (see db/engine.py normalize_database_url) — works the same against
# Supabase, a self-hosted Postgres instance, or MySQL.
DB_BACKEND=postgresql
DATABASE_URL=postgresql://dealercenter:CHANGE_ME@localhost:5432/dealercenter

# --- File storage (required) ---
# Where downloaded invoice PDFs are saved. Defaults to the RELATIVE
# path ./invoice_pdfs if unset — set this to an ABSOLUTE path in any
# real deployment, since a systemd unit's working directory isn't
# guaranteed to match dev assumptions.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/opt/dealercenter-agent/storage_data

# --- Redis / queue (required) ---
# Defaults to localhost:6379/0, which is correct when Redis runs on
# the same VM as the app (this deployment's setup). Only change this
# if Redis lives elsewhere.
QUEUE_REDIS_URL=redis://localhost:6379/0

# --- LLM / recovery-agent (not yet wired in — safe to leave blank) ---
# RecoveryAttempt/langsmith_run_id exist as DB columns for this future
# phase, but nothing in the current pipeline actually calls an LLM.
# No need to set these for a normal deployment today.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# LLM_API_KEY=
